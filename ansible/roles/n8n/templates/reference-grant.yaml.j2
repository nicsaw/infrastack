apiVersion: gateway.networking.k8s.io/v1beta1
kind: ReferenceGrant
metadata:
  name: n8n
  namespace: {{ n8n_namespace }}
  labels:
    app.kubernetes.io/name: n8n
    app.kubernetes.io/managed-by: ansible
spec:
  from:
    - group: gateway.networking.k8s.io
      kind: HTTPRoute
      namespace: {{ n8n_gateway_namespace }}
  to:
    - group: ""
      kind: Service
      name: n8n
