apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: hermes-agent
  namespace: default
  labels:
    app.kubernetes.io/name: hermes-agent
    app.kubernetes.io/managed-by: ansible
spec:
  parentRefs:
    - name: homelab
      namespace: default
  rules:
    - matches:
        - path:
            type: Exact
            value: /hermes
      filters:
        - type: RequestRedirect
          requestRedirect:
            path:
              type: ReplaceFullPath
              replaceFullPath: /hermes/
            statusCode: 302
    - matches:
        - path:
            type: PathPrefix
            value: /hermes/
      filters:
        - type: RequestHeaderModifier
          requestHeaderModifier:
            set:
              - name: X-Forwarded-Prefix
                value: /hermes
        - type: URLRewrite
          urlRewrite:
            path:
              type: ReplacePrefixMatch
              replacePrefixMatch: /
      backendRefs:
        - name: hermes-agent
          namespace: hermes-agent
          port: 9119
    - matches:
        - path:
            type: Exact
            value: /hermes-api
      filters:
        - type: RequestRedirect
          requestRedirect:
            path:
              type: ReplaceFullPath
              replaceFullPath: /hermes-api/
            statusCode: 302
    - matches:
        - path:
            type: PathPrefix
            value: /hermes-api/
      filters:
        - type: URLRewrite
          urlRewrite:
            path:
              type: ReplacePrefixMatch
              replacePrefixMatch: /
      backendRefs:
        - name: hermes-agent
          namespace: hermes-agent
          port: 8642
