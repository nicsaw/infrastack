apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: hermes-agent
  namespace: {{ hermes_agent_gateway_namespace }}
  labels:
    app.kubernetes.io/name: hermes-agent
    app.kubernetes.io/managed-by: ansible
spec:
  parentRefs:
    - name: {{ hermes_agent_gateway_name }}
      namespace: {{ hermes_agent_gateway_namespace }}
{% if hermes_agent_route_hostname | length > 0 %}
  hostnames:
    - {{ hermes_agent_route_hostname | quote }}
{% endif %}
  rules:
    - matches:
        - path:
            type: Exact
            value: {{ hermes_agent_dashboard_path | quote }}
      filters:
        - type: RequestRedirect
          requestRedirect:
            path:
              type: ReplaceFullPath
              replaceFullPath: {{ (hermes_agent_dashboard_path ~ '/') | quote }}
            statusCode: 302
    - matches:
        - path:
            type: PathPrefix
            value: {{ (hermes_agent_dashboard_path ~ '/') | quote }}
      filters:
        - type: RequestHeaderModifier
          requestHeaderModifier:
            set:
              - name: X-Forwarded-Prefix
                value: {{ hermes_agent_dashboard_path | quote }}
        - type: URLRewrite
          urlRewrite:
            path:
              type: ReplacePrefixMatch
              replacePrefixMatch: /
      backendRefs:
        - name: hermes-agent
          namespace: {{ hermes_agent_namespace }}
          port: 9119
    - matches:
        - path:
            type: Exact
            value: {{ hermes_agent_api_path | quote }}
      filters:
        - type: RequestRedirect
          requestRedirect:
            path:
              type: ReplaceFullPath
              replaceFullPath: {{ (hermes_agent_api_path ~ '/') | quote }}
            statusCode: 302
    - matches:
        - path:
            type: PathPrefix
            value: {{ (hermes_agent_api_path ~ '/') | quote }}
      filters:
        - type: URLRewrite
          urlRewrite:
            path:
              type: ReplacePrefixMatch
              replacePrefixMatch: /
      backendRefs:
        - name: hermes-agent
          namespace: {{ hermes_agent_namespace }}
          port: 8642
