apiVersion: gateway.networking.k8s.io/v1beta1
kind: ReferenceGrant
metadata:
  name: hermes-agent
  namespace: {{ hermes_agent_namespace }}
  labels:
    app.kubernetes.io/name: hermes-agent
    app.kubernetes.io/managed-by: ansible
spec:
  from:
    - group: gateway.networking.k8s.io
      kind: HTTPRoute
      namespace: {{ hermes_agent_gateway_namespace }}
  to:
    - group: ""
      kind: Service
      name: hermes-agent
