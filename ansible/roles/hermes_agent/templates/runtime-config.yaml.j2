apiVersion: v1
kind: ConfigMap
metadata:
  name: hermes-agent-runtime
  namespace: hermes-agent
  labels:
    app.kubernetes.io/name: hermes-agent
    app.kubernetes.io/managed-by: ansible
data:
  timezone: {{ hermes_agent_timezone | quote }}
  dashboard-public-url: {{ ('https://' ~ tailscale_dns_name ~ '/hermes') | quote }}
  camofox-crash-report-enabled: "false"
  camofox-vnc-resolution: {{ hermes_agent_camofox_vnc_resolution | quote }}
